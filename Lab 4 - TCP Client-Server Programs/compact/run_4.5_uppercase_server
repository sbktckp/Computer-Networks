#!/usr/bin/env bash
# Compiles and runs 4.5_uppercase_server.c (compact version) directly. Usage: ./run_4.5_uppercase_server [args...]
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$dir/4.5_uppercase_server.c"
bin="$(mktemp)"
gcc -std=c17 -O2 -Wall -Wextra -Wpedantic -o "$bin" "$src"
exec "$bin" "$@"
