#!/usr/bin/env bash
# Compiles and runs 4.3_one_way_message_server.c directly. Usage: ./run_4.3_one_way_message_server [args...]
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$dir/4.3_one_way_message_server.c"
bin="$(mktemp)"
gcc -std=c17 -O2 -Wall -Wextra -Wpedantic -o "$bin" "$src"
exec "$bin" "$@"
