#!/usr/bin/env bash
# Compiles and runs 2.1_word_count_server.c directly. Usage: ./run_2.1_word_count_server [args...]
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$dir/2.1_word_count_server.c"
bin="$(mktemp)"
gcc -std=c17 -O2 -Wall -Wextra -Wpedantic -o "$bin" "$src"
exec "$bin" "$@"
