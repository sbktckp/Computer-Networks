#!/usr/bin/env bash
# ./run                        list every buildable program, grouped by week
# ./run 2.1                    run full version of Assignment 2, question 2.1
# ./run compact/2.1            run compact version of Assignment 2, question 2.1
# ./run 3.1                    run full version of Day 3, question 3.1
# ./run 2.3 999                extra words are forwarded as argv to the program
set -euo pipefail
cd "$(dirname "$0")"

if [ $# -eq 0 ]; then
    make -s all >/dev/null
    echo "Available programs:"
    find bin -mindepth 2 -maxdepth 3 -type f | sed 's|^bin/||' | sort
    exit 0
fi

target="$1"; shift
make -s all >/dev/null

# target is a bare id like "2.1" or "compact/2.1"; search every week's
# bin/ subfolder for a matching binary rather than requiring the week
# name up front.
match=$(find bin -mindepth 2 -maxdepth 3 -type f -path "*/${target}*" 2>/dev/null | head -n1)

if [ -z "$match" ]; then
    echo "No program matches '$target'. Run ./run with no arguments to list options." >&2
    exit 1
fi

exec "$match" "$@"
