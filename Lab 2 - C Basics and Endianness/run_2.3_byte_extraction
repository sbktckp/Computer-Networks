#!/usr/bin/env bash
# Compiles and runs 2.3_byte_extraction.c directly. Usage: ./run_2.3_byte_extraction [args...]
set -euo pipefail
dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src="$dir/2.3_byte_extraction.c"
bin="$(mktemp)"
gcc -std=c17 -O2 -Wall -Wextra -Wpedantic -o "$bin" "$src"
exec "$bin" "$@"
